{% extends 'base.admin.html.twig' %}

{% block title %}
    Admin Minics | Categorie de produits
{% endblock %}

{% block body %}
    <div class="container">
    {#     success, objet message  #}
    {% for label, messages in app.flashes(['success', 'danger']) %}
        {# 'La categorie a été enregistrée.' in objet message #}
        {% for message in messages %}
            <div class="bg-{{ label }} text-white p-3 mb-3">
                {{ message|raw }}
            </div>
        {% endfor %}
    {% endfor %}

    <div>
        <h2 class="my-4 fs-3">Liste des categories</h2>

        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Titre</th>
                    <th>Description</th>
                    <th>Enregisteé le</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for item in dbCategory %}
                    {# {{ dump(item) }} #}
                    <tr>
                        <td>{{ item.title }}</td>
                        <td>{{ item.description }}</td>
                        <td>{{ item.createdAt|date('d/m/Y à H:i:s') }}</td>
                        <td>
                            <a href="{{ path('app_admin_category_update', {'id': item.id}) }}" class="btn btn-dark mb-2">
                                <i class="fa-solid fa-pencil"></i>
                            </a>
                            <a href="" class="btn btn-danger"  data-toggle="modal" data-target="#exampleModal">
                                <i class="fa-solid fa-trash"></i>
                            </a>
                        </td>

                        <!-- Modal -->
                        <div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
                        <div class="modal-dialog" role="document">
                            <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="exampleModalLabel">Modal title</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                ...
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                                <button type="button" class="btn btn-primary">Save changes</button>
                            </div>
                            </div>
                        </div>
                        </div>

                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div>
        <h2 class="my-4 fs-3">Ajouter une categorie</h2>
        {{form_start(categoryForm) }}
        {{form_row(categoryForm.title) }}
        {{form_row(categoryForm.description) }}
        <button type="submit" class="btn btn-dark">Enregistrer</button>
        {{form_end(categoryForm) }}
    </div>
    </div>

{% endblock %}