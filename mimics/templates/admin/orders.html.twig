{% extends 'base.admin.html.twig' %}

{% block title %}
    Admin Minics | Commandes    
{% endblock %}

{% block body %}
	<style>
		.modal-backdrop {
			z-index: 1 !important;
		}
	</style>

	<div
		class="container">
		{#     success, OBJET MESSAGE  #}
		{% for label, messages in app.flashes(['success', 'danger']) %}
			{# "La catégorie a été enregistrée." in OBJET MESSAGE   #}

			{% for message in messages %}
				{#          bg-success  #}
				{#          bg-danger  #}
					<div class="bg-{{ label }} text-white p-3 mb-3"> {{ message|raw }}
				</div>
			{% endfor %}
		{% endfor %}

		<div>
			<h2 class="my-4 fs-3">Liste des Commandes</h2>

			<table class="table table-bordered">
				<thead>
					<tr>
						<th>Numéro de la commande</th>
						<th>Faite le</th>
						<th>Envoyer le</th>
						<th>Reçu le</th>
						<th>état</th>
					</tr>
				</thead>
				<tbody>
					{% for item in dbOrder %}
						{# {{ dump(item) }} #}
						<tr>
							<td>{{ item.orderNumber }}</td>
							<td>{{ item.createdAt|date('d/m/Y à H:i:s') }}</td>
							<td>{{ item.sentAt|date('d/m/Y à H:i:s') }}</td>
							<td>{{ item.deliveredAt|date('d/m/Y à H:i:s') }}</td>
							<td>{{ item.state }}</td>
							<td>
								<a href="{{ path('app_admin_orders_update', {'id': item.id}) }}" class="btn btn-dark">
									<i class="fa-solid fa-pen-to-square"></i>
								</a>
								<button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#order-{{ item.id }}">
									<i class="fa-solid fa-trash"></i>
								</button>
							</td>
						</tr>

						<div class="modal fade" id="order-{{ item.id }}" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
							<div class="modal-dialog">
								<div class="modal-content">
									<div class="modal-header">
										<h1 class="modal-title fs-5" id="exampleModalLabel">Confirmation suppression</h1>
										<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
									</div>
									<div class="modal-body">
										Voulez-vous réellement supprimer la commande
										<strong>{{ item.orderNumber }}</strong>
										?
									</div>
									<div class="modal-footer">
										<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>

										<a href="" class="btn btn-primary">Confirmer</a>
                                        {# {{ path('app_admin_orders_remove', {'id': item.id}) }} #}
									</div>
								</div>
							</div>
						</div>


					{% endfor %}
				</tbody>
			</tbody>
		</table>
	</div>

	<div>
		<h2 class="my-4 fs-3">Ajouter une catégorie</h2>

		{{ form_start(orderForm) }}

		{{ form_row(orderForm.title) }}

		{{ form_row(orderForm.description) }}

		<button type="submit" class="btn btn-dark">Enregistrer</button>

		{{ form_end(orderForm) }}
	</div>
</div>
{% endblock %}