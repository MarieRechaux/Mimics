{% extends 'base.html.twig' %}

{% block title %}
    Minics | Mon compte
{% endblock %}

{% block body %}
    
    {# 
        Exo : 
        - créer le compte utilisateur
        - afficher les données personnelles de l'utilisateur qui est connecté en passant par l'objet app.user
        - faite en sorte de rediriger l'internaute si il tente d'accéder a cette page si il n'est pas authentifié.
     #}

    <div class="col-12 col-sm-8 col-md-6 col-lg-6 mx-auto">
        <h1 class="text-center mx-auto -my-4">Vos information personnelles</h1>
        <div class="card">
            <div class="card-body">
                <div class="d-flex alin-items-center justify-content-betwwen">
                    <strong>Prénom</strong>
                    <span>{{ app.user.firstName }}</span>
                </div>
                <div class="d-flex alin-items-center justify-content-betwwen">
                    <strong>Nom</strong>
                    <span>{{ app.user.lastName }}</span>
                </div>
                <div class="d-flex alin-items-center justify-content-betwwen">
                    <strong>Email</strong>
                    <span>{{ app.user.email }}</span>
                </div>
                <div class="d-flex alin-items-center justify-content-betwwen">
                    <strong>Téléphone</strong>
                    <span>{{ app.user.phone }}</span>
                </div>
                <div class="d-flex alin-items-center justify-content-betwwen">
                    <strong>Adresse</strong>
                    <span>{{ app.user.address }}</span>
                </div>
                <div class="d-flex alin-items-center justify-content-betwwen">
                    <strong>Ville</strong>
                    <span>{{ app.user.city }}</span>
                </div>
                <div class="d-flex alin-items-center justify-content-betwwen">
                    <strong>code postal</strong>
                    <span>{{ app.user.zipcode }}</span>
                </div>
                <div class="d-flex alin-items-center justify-content-betwwen">
                    <a href="" class="btn btn-dark">Modifier</a>
                </div>
            </div>
        </div>
    </div>

{% endblock %}